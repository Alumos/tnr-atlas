# 使用 latest 跟随后续发布；每次更新需重新拉取并创建 TNR 容器。
TNR_IMAGE=ghcr.io/alumos/tnr-atlas:latest
# 如需固定本次版本，可改为 ghcr.io/alumos/tnr-atlas:0.1.0。
TNR_PUBLIC_ORIGIN=https://cats.example.com
# 同时供 TNR 补全相对图片路径，以及设置 oneimg 的 APP_URL。
ONEIMG_PUBLIC_ORIGIN=https://img.example.com
TNR_PORT=8081
ONEIMG_PORT=8082

# 以下示例标记必须替换；公共访问码和管理员密码需不同且至少 16 字节。
# TNR_ACCESS_CODE 仅在空数据库首次初始化时使用，之后请从 /admin 修改。
TNR_ACCESS_CODE=REPLACE_WITH_INITIAL_ACCESS_CODE
TNR_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
ONEIMG_INITIAL_PASSWORD=REPLACE_WITH_ONEIMG_ADMIN_PASSWORD

# 首次可留空，oneimg 配置完成后填入并重新创建 tnr 容器。
ONEIMG_TOKEN=
# 在 oneimg 手工创建 NTR 文件夹，打开后地址中的 folder_id 即为此值。
ONEIMG_FOLDER_ID=0
ONEIMG_IMAGE=onexru/oneimg-oneimg:latest
# 按服务器的实际反向代理来源填写。与 Mac 网络配置无关。
ONEIMG_TRUSTED_PROXIES=
